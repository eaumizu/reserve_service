{
  "name": "seitai-reservation-v1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview --port 3013",
    "cf:deploy:staging": "opennextjs-cloudflare deploy",
    "cf:deploy:production": "opennextjs-cloudflare deploy --env production",
    "cf:reminders:deploy": "wrangler deploy --config cloudflare/wrangler.reminders.jsonc",
    "cf:smoke": "node tests/cloudflare-smoke.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "next": "15.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@opennextjs/cloudflare": "1.20.13"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.28",
    "typescript": "^5",
    "vitest": "^3",
    "wrangler": "4.152.0"
  },
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.0.0 <25"
  }
}
