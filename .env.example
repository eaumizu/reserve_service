NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never put this in NEXT_PUBLIC_ variables or browser code.
SUPABASE_SERVICE_ROLE_KEY=
# Demo store UUID from supabase/seed.sql; replace in production.
NEXT_PUBLIC_DEFAULT_STORE_ID=11111111-1111-1111-1111-111111111111
# Public variables above are needed at build time and runtime on Cloudflare.
# Server-only runtime settings below belong in Runtime variables and secrets,
# not in Builds. Keep real values outside Git.
LINE_BOOKING_SITE_URL=
# Preserve the existing 64-character hexadecimal encryption key during migration.
LINE_SETTINGS_ENCRYPTION_KEY=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
RESEND_API_KEY=
# At least 32 random characters; same runtime Secret on both production Workers.
CRON_SECRET=
