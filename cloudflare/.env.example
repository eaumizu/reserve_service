# Build values: use the target environment's Supabase project (not production for staging).
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key
NEXT_PUBLIC_DEFAULT_STORE_ID=11111111-1111-1111-1111-111111111111
# Add these three public values to Worker runtime Variables as well.
# Set server credentials in Worker runtime Secrets, never NEXT_PUBLIC_*:
# SUPABASE_SERVICE_ROLE_KEY
# GOOGLE_CALENDAR_CLIENT_ID
# GOOGLE_CALENDAR_CLIENT_SECRET
# LINE_SETTINGS_ENCRYPTION_KEY  (EXACT existing production value; do not generate a replacement)
# RESEND_API_KEY
# CRON_SECRET  (same value on production app and reminder worker; at least 32 characters)
# LINE_BOOKING_SITE_URL=https://your-production-app-host
# No secrets belong in this file or in wrangler.jsonc.
